      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst first = (...values) => values.find(v => v !== undefined && v !== null && String(v).trim() !== '') ?? '';\nconst rawPhone=first(body.phone,body.caller_phone,body.from,body.customer_phone);\nconst phone=String(rawPhone).replace(/[()\\\\s.-]/g,'');\nconst consentRaw=first(body.consent_to_text,body.sms_consent,false);\nconst consent=consentRaw===true||String(consentRaw).toLowerCase()==='true'||String(consentRaw).toLowerCase()==='yes';\nconst businessName=String(first(body.business_name,'your HVAC team'));\nconst customerName=String(first(body.customer_name,body.name,'there'));\nconst callStatus=String(first(body.call_status,body.status,'missed')).toLowerCase();\nconst optedOut=String(first(body.opted_out,false)).toLowerCase()==='true';\nreturn [{json:{event_type:'hvac_missed_call',call_id:String(first(body.call_id,body.id,'')),phone,customer_name:customerName,business_name:businessName,call_status:callStatus,consent_to_text:consent,opted_out:optedOut,should_text:phone.length>=7&&consent&&!optedOut&&['missed','no-answer','busy','failed','unanswered'].includes(callStatus),received_at:new Date().toISOString(),sms_body:`Hi ${customerName}, sorry we missed your call. This is ${businessName}. How can we help with your heating or AC service? Reply STOP to opt out.`}}];"
      },
